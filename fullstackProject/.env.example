# Скопируйте в .env при локальном запуске без docker compose
# (в docker compose значения заданы напрямую в docker-compose.yml)

# --- NestJS API (apps/api) ---
# PORT=13000  # 3000 часто занят локальными dev-серверами
PORT=3000
# если postgres поднят через docker compose — порт 15432
DATABASE_URL=postgres://cine:cine@localhost:15432/cine
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# секрет подписи JWT (логин выдаёт accessToken на 2 ч); дефолт — только для dev
# JWT_SECRET=change-me-in-production
# окно оплаты брони: TTL wait-очереди RabbitMQ + дедлайн expires_at
# (дефолт 900000 = 15 мин; compose-стенд держит 120000 = 2 мин)
# PAYMENT_TIMEOUT_MS=900000
# админ сеется при старте API (данные по умолчанию — демонстрационные)
# ADMIN_EMAIL=admin@cine.local
# ADMIN_PASSWORD=admin-secret-1
# Схема БД создаётся миграциями TypeORM; API применяет их автоматически
# при старте. Ручной прогон/откат/статус: npm run migration:run|revert|show
# из apps/api (нужен поднятый postgres).
# база одноразовой ссылки сброса пароля в «письме» (дефолт — фронт стенда):
# RESET_LINK_BASE=http://localhost:18080/#/reset-password

# --- Go-воркер (services/ticket-worker) ---
AMQP_URL=amqp://guest:guest@localhost:5672/
HTTP_ADDR=:8081
WORKER_ID=go-worker-1
PROCESS_MIN_MS=1200
PROCESS_MAX_MS=2800
SUCCESS_RATE=0.9

# --- Go-уведомления (services/notification-service) ---
# дефолт STORAGE=memory — кольцевой буфер, без БД; postgres включает
# персистентную историю в собственной базе (сервис создаёт её сам)
# STORAGE=postgres
# DATABASE_URL=postgres://cine:cine@localhost:15432/cine_notifications
# база live-тестов postgres-адаптера (пересоздаётся каждым прогоном):
# TEST_DATABASE_URL=postgres://cine:cine@localhost:15432/cine_notifications_test

# --- Web (apps/web, Vite) ---
# адрес API для production-сборки; по умолчанию — тот же origin
# VITE_API_URL=https://your-api-host/api
