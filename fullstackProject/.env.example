# Скопируйте в .env при локальном запуске без docker compose
# (в docker compose значения заданы напрямую в docker-compose.yml)

# --- NestJS API (apps/api) ---
PORT=3000
DATABASE_URL=postgres://cine:cine@localhost:5432/cine
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# отключить авто-создание схемы (для «продакшен»-режима)
# TYPEORM_SYNCHRONIZE=false

# --- Go-воркер (services/ticket-worker) ---
AMQP_URL=amqp://guest:guest@localhost:5672/
HTTP_ADDR=:8081
WORKER_ID=go-worker-1
PROCESS_MIN_MS=1200
PROCESS_MAX_MS=2800
SUCCESS_RATE=0.9

# --- Web (apps/web, Vite) ---
# адрес API для production-сборки; по умолчанию — тот же origin
# VITE_API_URL=https://your-api-host/api
