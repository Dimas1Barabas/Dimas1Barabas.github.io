# Скопируйте в .env при локальном запуске без docker compose
# (в docker compose значения заданы напрямую в docker-compose.yml)

# --- NestJS API (apps/api) ---
# PORT=13000  # 3000 часто занят локальными dev-серверами
PORT=3000
# если postgres поднят через docker compose — порт 15432
DATABASE_URL=postgres://cine:cine@localhost:15432/cine
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Схема БД создаётся миграциями TypeORM; API применяет их автоматически
# при старте. Ручной прогон/откат/статус: npm run migration:run|revert|show
# из apps/api (нужен поднятый postgres).

# --- Go-воркер (services/ticket-worker) ---
AMQP_URL=amqp://guest:guest@localhost:5672/
HTTP_ADDR=:8081
WORKER_ID=go-worker-1
PROCESS_MIN_MS=1200
PROCESS_MAX_MS=2800
SUCCESS_RATE=0.9

# --- Web (apps/web, Vite) ---
# адрес API для production-сборки; по умолчанию — тот же origin
# VITE_API_URL=https://your-api-host/api
