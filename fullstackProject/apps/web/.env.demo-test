# Сборка демо-режима под браузерные тесты (vite build --mode demo-test).
# Вердикты оплаты/возврата детерминированы, фоновые «зрители» живой карты
# молчат — вероятностями витрины управляет тест (см. DEMO_TEST_BUILD
# в src/shared/api/demo-engine.ts). В обычную сборку и vitest не попадает:
# vite грузит .env.[mode] только при сборке с этим --mode.
VITE_DEMO_TEST=1
